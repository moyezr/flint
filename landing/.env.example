# Required for the licensing API and migrations.
DATABASE_URL=

# Required to email a purchaser before replacing the active Flint device.
RESEND_API_KEY=
LICENSE_EMAIL_FROM="Flint <licenses@example.com>"
BETA_EMAIL_FROM="Flint <beta@example.com>"

# A high-entropy secret used to hash license keys before database storage.
# Generate with: openssl rand -hex 32
LICENSE_KEY_PEPPER=

# High-entropy secret used to pseudonymize short-lived abuse-control counters.
# If omitted, LICENSE_KEY_PEPPER is used for backward-compatible deployments.
# Generate with: openssl rand -hex 32
BETA_ABUSE_PEPPER=

# Separate high-entropy secret used to hash short-lived beta email OTPs.
# Generate with: openssl rand -hex 32
BETA_OTP_PEPPER=

# Ed25519 PKCS#8 private key, base64 encoded on one line. It signs offline
# activation certificates. Keep it server-side only.
LICENSE_SIGNING_PRIVATE_KEY=

# Public half of the signing key. It is embedded in the macOS client and is
# included here only to keep deployment configuration auditable.
LICENSE_CERTIFICATE_PUBLIC_KEY=

# Must match app/Distribution/Info.plist.
LICENSE_APP_BUNDLE_ID=com.moyezrabbani.Flint

# Public URL used in purchaser transfer emails.
NEXT_PUBLIC_SITE_URL=https://flint.moyezrabbani.dev

# Inbox used only by the disposable deployed beta-flow verifier. Plus-addressing
# must be supported so each run remains isolated.
FLINT_BETA_TEST_EMAIL=

# Base palette for the landing site. Allowed values: warm (default), slate.
NEXT_PUBLIC_FLINT_BASE_THEME=warm

# Optional beta release overrides. Checked-in defaults point at the current
# immutable versioned asset and can be overridden without a code change.
FLINT_BETA_VERSION=0.1.0-beta.3
FLINT_BETA_BUILD=3
FLINT_BETA_PUBLISHED_AT=2026-07-17T00:00:00Z
FLINT_BETA_DMG_URL=https://flint.moyezrabbani.dev/downloads/Flint-0.1.0-beta.3.dmg
FLINT_BETA_SHA256=0214c9eaae8e5fec75551cac7febd2619577b27ee557658a5a279c943164d11a

# Shared secret for the future payment-provider webhook adapter.
COMMERCE_WEBHOOK_SECRET=
